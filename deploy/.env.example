# ============================================================
# Geo Collab 生产部署环境变量模板（deploy/，新栈 geo-ci）
# 复制为 deploy/.env 后填入真实值；docker-compose.prod.yml 与 app/worker 共用此文件。
# 所有 change_me_* 必须替换。镜像与环境无关——同一镜像包配不同 .env 即可部署到不同环境。
# 发布 worker 只运行 1 个实例，不要 docker compose --scale worker=N。
# ============================================================

# 新栈 compose 项目名（隔离老栈 geo；容器名将是 geo-ci-*）
COMPOSE_PROJECT_NAME=geo-ci
# 对外端口：避开老栈占用的 80/443，用高端口
HTTP_PORT=8081

# ---------- MySQL 数据库 ----------
# MYSQL_USER 不能填 root（mysql 镜像会拒绝并崩溃重启）；应用以此用户连库，
# 自动获得对 MYSQL_DATABASE 的完整授权，无需 root。root 密码由 MYSQL_ROOT_PASSWORD 控制。
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=geo_collab
MYSQL_USER=geo_user
MYSQL_PASSWORD=change_me_user

# ---------- MinIO 对象存储（图片库依赖，必填）----------
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_pass

# ---------- JWT 鉴权 ----------
# 用 openssl rand -hex 32 生成
GEO_JWT_SECRET=change_me_jwt_secret_64_chars_minimum

# 生产 HTTPS 部署时设为 true，否则 cookie 不带 Secure 标志
# GEO_SECURE_COOKIE=true

# JWT 过期小时数（默认 8）
# GEO_JWT_EXPIRE_HOURS=8

# ---------- 初始用户 ----------
# JSON 数组，例: [{"username":"admin","password":"admin123","role":"admin"}]
GEO_SEED_USERS=change_me_json_array

# ---------- 飞书 ----------
# 任务完成通知 webhook（可选）
# GEO_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# 问题库多维表同步凭据（与 webhook 不同；可选）
# GEO_FEISHU_APP_ID=
# GEO_FEISHU_APP_SECRET=

# ---------- AI 生文（仅 web UI 方案运行 / 自动排版用，MCP loop 不需要）----------
# 模型 ID 必须带 provider 前缀（anthropic/ openai/ deepseek/ ...）
# GEO_AI_MODEL=anthropic/claude-3-5-sonnet-20241022
# GEO_AI_API_KEY=
# GEO_AI_ENGINES=
# GEO_AI_FORMAT_MODEL=deepseek/deepseek-v4-flash
# GEO_AI_FORMAT_API_KEY=

# ---------- MCP server（POC，可选）----------
# GEO_MCP_TOKEN=changeme-openssl-rand-hex-32

# ---------- 发布引擎（可选调优）----------
# 生产建议先设 2~3 降低平台风控
# GEO_PUBLISH_MAX_CONCURRENT_RECORDS=3
# GEO_PUBLISH_RECORD_TIMEOUT_SECONDS=300
